# (Opsional) URL situs untuk metadata/OG:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (akun yang sama dengan aplikasi Melvoc).
# Dua nilai ini aman dipublikasikan. Ambil di Supabase Dashboard > Project Settings > API.
# Isi juga di Vercel > Project Settings > Environment Variables (tipe Config).
NEXT_PUBLIC_SUPABASE_URL=https://krzjdwfygolptwfrzqyv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# RAHASIA, khusus server: dipakai untuk login token (mencocokkan token lisensi).
# Ambil di Supabase Dashboard > Project Settings > API Keys > secret key.
# Di Vercel pilih tipe Secret. JANGAN diawali NEXT_PUBLIC_ dan jangan dibagikan.
SUPABASE_SERVICE_ROLE_KEY=

# RAHASIA, khusus server: HARUS SAMA PERSIS dengan SESSION_SECRET di project DAW (Melvox).
# Dipakai mengenkripsi token plugin saat pembeli menekan Buy plugin, supaya admin DAW bisa membukanya
# lewat ikon mata di /admin. Kalau beda, token pesanan tidak bisa dibuka admin.
SESSION_SECRET=
